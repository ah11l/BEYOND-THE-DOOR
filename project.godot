; Engine configuration file.
; BEYOND THE DOOR — ما وراء الباب (Godot 4.3+)

config_version=5

[application]

config/name="Beyond the Door — ما وراء الباب"
config/description="Atmospheric 3D low-poly isometric puzzle-exploration game for Android."
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
LocalizationManager="*res://scripts/autoload/localization_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
MonetizationBridge="*res://scripts/autoload/monetization_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom_font="res://assets/fonts/NotoSansArabic-Regular.ttf"

