		"world_1_name": "The Forgotten Islands",
		"world_1_story": "Chapter I — The Forgotten Islands: You wake without a name, holding only a trembling cyan lantern. Behind you walks your Echo — a silent fragment of your past self that refuses to leave you alone.",
		"world_2_name": "The Whispering Forest",
		"world_2_story": "Chapter II — The Whispering Forest: Blue Doors turn falling into rising. Ancient notes speak of an Architect who built these islands out of grief, yet your Echo's whispers begin to contradict what the stones remember.",
		"world_3_name": "City of Stopped Clocks",
		"world_3_story": "Chapter III — City of Stopped Clocks: Purple Doors reveal two faces of time — what stood before the Rift, and what shattered after. A hooded Guardian appears, warning you not to open the final seal.",
		"world_4_name": "The Silent Abyss",
		"world_4_story": "Chapter IV — The Silent Abyss: Black Doors cross into the twin backup world draining the original. You begin to realize the Guardian may not be your enemy — he is trying to stop a mistake from repeating.",
		"world_5_name": "Sea of Mirrors",
		"world_5_story": "Chapter V — Sea of Mirrors: The truth breaks through the glass: YOU are the Architect. Echo is the fearful piece of you that froze time to survive, while the Guardian is the conscience you left behind to stop yourself.",
		"suspense_watcher_w1": "A hooded figure watched you from the ledge... then vanished like smoke.",
		"suspense_watcher_w2": "Your own silhouette flickered between the pines—was that a memory?",
		"suspense_watcher_w3": "Someone stood motionless beside the gears, then dissolved as you neared.",
		"suspense_watcher_w4": "A pale watcher stared from the abyssal mist before fading into the dark.",
		"suspense_watcher_w5": "Your reflection stepped out of the mirror—and disappeared in shards of light.",
		"suspense_watcher_w6": "The Keeper's echo bowed from afar before melting into golden starlight.",
		"suspense_tremor_w1": "The island trembled—a sudden beam of light struck the Golden Door!",
		"suspense_tremor_w2": "Deep roots shuddered beneath your feet as the forest called to the Door.",
		"suspense_tremor_w3": "A giant distant clock chimed once—sending a pulse toward the exit!",
		"suspense_tremor_w4": "The abyss rumbled below as a turquoise beacon pierced the dark sky.",
		"suspense_tremor_w5": "A crystalline tremor rippled across the mirrors, lighting the path ahead.",
		"suspense_tremor_w6": "The sanctuary hummed with golden thunder—something awaits beyond the Door.",
		"suspense_wisp_w1": "A drifting lantern wisp whispered: 'Follow the light where stone remembers.'",
		"suspense_wisp_w2": "The forest wisp chimed softly: 'Listen closely—not every echo is yours.'",
		"suspense_wisp_w3": "A golden spark murmured: 'Time stopped here to protect what you forgot.'",
		"suspense_wisp_w4": "The abyssal wisp flickered: 'Look down only to leap higher.'",
		"suspense_wisp_w5": "A mirror wisp whispered: 'Truth hides behind the reflection you fear.'",
		"suspense_wisp_w6": "A dawn wisp sang softly: 'The final threshold remembers your name.'",
		"suspense_omen_w1": "An ancient ring drifted across the stars... something knows you are awake.",
		"suspense_omen_w2": "A watchful eye of mist glided above the canopy—keep moving.",
		"suspense_omen_w3": "A giant celestial eye swept the horizon as the stopped clocks ticked once.",
		"suspense_omen_w4": "You felt a cold gaze from the abyssal sky... the Guardian is closer.",
		"suspense_omen_w5": "A luminous halo crossed the nebula, reflecting every step you took.",
		"suspense_omen_w6": "The Architect's astral sign passed overhead—the final door draws near.",
		"world_6_name": "Beyond the Door",
		"world_6_story": "Final Chapter — Beyond the Door: All four doors converge. Reach Stage 120, face your Echo before the ancient gate, and remember why your lantern lit itself in Stage 1.",
		"world_cine_w1": "Echo: 'Follow the golden gates — together we can mend what broke.'",
		"world_cine_w2": "Echo: 'The trees still whisper your name... don't listen to the shadows.'",
		"world_cine_w3": "Guardian: 'Every stopped clock marks the exact second you refused to let go.'",
		"world_cine_w4": "Guardian: 'Look into the Abyss — the twin world is starving the real one.'",
		"world_cine_w5": "Echo: 'Do not look into the mirrors! If you remember, you will erase me!'",
		"world_cine_w6": "The Architect's Sanctuary opens. Every door you built now waits for your verdict.",
		"world_label": "World",
	},
	"ar": {
		"ad_hint_granted": "تم فتح التلميح!",
		"ad_offline_notice": "لا يتوفر إعلان بدون إنترنت — يمكنك مواصلة اللعب أوفلاين.",
		"ad_skip_granted": "تم تخطي المرحلة بنجاح!",
		"boss_seals_label": "الأختام",
		"boss_shockwave_hit": "أصابتك موجة الحارس! اقفز فوق الحلقة المضيئة لتفاديها.",
		"boss_title_w1": "حارس الجزر المنسية",
		"boss_title_w2": "حارس غابة الهمس",
		"boss_title_w3": "حارس الساعات المتوقفة",
		"boss_title_w4": "حارس الهاوية الصامتة",
		"boss_title_w5": "صدى الخوف",
		"boss_title_w6": "الصدى الأخير",
		"boss_w1_defeated": "حارس الجزر المنسية: «صداك يزداد جرأة… أنصت جيداً لما يخفيه عنك.»",
		"boss_w1_intro": "حارس الجزر المنسية: «ارجع يا مسافر… كل بابٍ تفتحه يوقظ جرحاً نائماً.»",
		"boss_w2_defeated": "حارس غابة الهمس: «انكسر الختم… لكن الغابة لا تزال تذكر خطواتك القديمة.»",
		"boss_w2_intro": "حارس غابة الهمس: «انقلبت السماء حين رفضتَ أن تتخلى. أثبت أنك ما زلتَ قادراً على الصعود.»",
		"boss_w3_defeated": "حارس الساعات: «ألا تزال لا تعرف خطّ يدك المحفور على هذه الجدران؟»",
		"boss_w3_intro": "حارس الساعات: «توقف! وجها هذه المدينة تشققا بسببك أنت.»",
		"boss_w4_defeated": "حارس الهاوية: «امضِ إذن نحو المرايا… واحكم على نفسك بنفسك.»",
		"boss_w4_intro": "حارس الهاوية: «العالم التوأم يستنزف العالم الحيّ. لا تُطعم الدورة من جديد!»",
		"boss_w5_defeated": "صدى الخوف: «سأنتظرك عند الباب الأخير… لن تستطيع محوي.»",
		"boss_w5_intro": "صدى الخوف: «لا تصدّق الحارس! من دون الأبواب سنختفي أنا وأنت إلى الأبد!»",
		"boss_w6_defeated": "انفتح الباب القديم — والفانوس الذي تركتَه لنفسك كشف الحقيقة أخيراً.",
		"boss_w6_intro": "الصدى الأخير: «أنت من أشعل ذلك الفانوس في المرحلة الأولى كي تعود إليّ. اختر مصيرنا الآن.»",
		"btn_help_short": "شرح",
		"btn_hint_short": "تلميح",
		"btn_memories_short": "الذكريات",
		"btn_reset_short": "إعادة",
		"btn_skip_short": "تخطي",
		"btn_stages_short": "المراحل",
		"cine_skip": "تخطي ◂",
		"clue_01": "ينتظر النور الذهبي خلف الجسر. التفت جانباً بحثاً عن البلورات المنسية.",
		"clue_04_echo": "قف على اللوح أثناء تسجيل الصدى، ثم اعبر بينما يثبّته صداك.",
		"clue_09_sky": "اتبع الفوانيس الدافئة — فهي تشير إلى منصات الهبوط الآمنة.",
		"clue_14_echo_only": "هذا الختم الأزرق لا يستجيب إلا لطيف الصدى — قف عليه أثناء التسجيل ثم ابتعد لتراه يفتح الباب!",
		"clue_16_alt": "يقود الباب الأسود إلى توأم الغرفة. ما ينقص هنا قد ينتظرك هناك.",
		"clue_19_alt": "خذ المفتاح جنوباً، ثم عد عبر الباب الأسود الشمالي.",
		"clue_19_prime": "يرقد المفتاح في العالم الموازي، بينما يثبّت الحجر هذا الجسر.",
		"clue_20_hardcore": "التحدي الأعظم: الحجر يفتح المفتاح الشمالي • البنفسجي والأزرق للمفتاح السماوي • ختم الصدى يفتح البوابة الذهبية.",
		"clue_25_reveal": "أنا من بنى هذه الأبواب لإنقاذ العوالم المنهارة، ومحوتُ ذاكرتي لأحكم عليها بصدق.",
		"clue_29_finale": "المفتاح في الظل، الصعود بالأزرق، الجسر بالبنفسجي، والثبات بالصدى.",
		"clue_30_truth": "أمامك ثلاثة مصائر في المرحلة 120: إيقاف الدورة، إعادة تشغيلها، أو — بجمع 60 بلورة ذكرى — تحرير العوالم كلها.",
		"credits_body": "ما وراء الباب — BEYOND THE DOOR\nتطوير استوديو: majnon.studio\nلعبة ألغاز واستكشاف ثلاثية الأبعاد تعمل دون اتصال.\nالخطوط: Noto Sans و Noto Sans Arabic.",
		"crystal_powers_header": "قوى البلورات: 10 ◆ البصيرة  —  25 ◆ صدى 7 ثوانٍ  —  45 ◆ سرعة +15%  —  60 ◆ النهاية السرية",
		"diff_master": "صعب (محترف)",
		"diff_normal": "عادي",
		"diff_story": "سهل (قصة)",
		"echo_cancelled": "تم إلغاء الصدى.",
		"echo_recording_started": "بدأ تسجيل الصدى (حتى 5 ثوانٍ)... اضغط الصدى مجدداً للإعادة.",
		"echo_replaying": "الصدى يكرر حركتك الآن.",
		"echo_too_short": "التسجيل قصير جداً — تحرك لفترة أطول قليلاً.",
